{
  "name": "aldaffa-app-desktop",
  "version": "2.3.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdluffy-v/aldaffa-erp-system.git"
  },
  "description": "Aldaffa Perfumes ERP Desktop Application",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --linux deb",
    "postinstall": "electron-rebuild"
  },
  "keywords": [
    "erp",
    "perfumes",
    "electron",
    "pos"
  ],
  "homepage": "https://github.com/aldaffa/aldaffa-erp-desktop",
  "author": {
    "name": "Aldaffa Perfumes",
    "email": "info@aldaffa.sd"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.1",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.aldaffa.erp",
    "productName": "Aldaffa ERP",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rdluffy-v",
        "repo": "aldaffa-erp-system",
        "private": true
      }
    ]
  }
}
